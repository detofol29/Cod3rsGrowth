<mvc:View
	controllerName="cod3rsgrowth.app.controller.ListaDeFilmes"
	xmlns="sap.ui.table"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:u="sap.ui.unified"
	xmlns:c="sap.ui.core"
	xmlns:m="sap.m"
    height="100%">
	<m:Page
		id="ListaDeFilmes"
		showHeader="false"
		enableScrolling="false"
		class="sapUiContentPadding">
		<m:content>
			<Table
				rows="{filme>/}"
				selectionMode="MultiToggle"
				paste="app"
				ariaLabelledBy="title">
				<extension>
					<m:OverflowToolbar style="Clear">
						<m:Title id="ListaDeFilmesTitulo" text="Filmes"/>
					</m:OverflowToolbar>
				</extension>
				<columns>
					<Column width="18rem" hAlign="Center">
						<m:Label text="Titulo" />
						<template>
							<m:Text text="{filme>titulo}" wrapping="false" />
						</template>
					</Column>
                    
					<Column width="9rem" hAlign="Center">
						<m:Label text="Genero" />
						<template>
							<m:ObjectStatus text="{filme>genero}"/>
							<!-- <Text text="{path: 'filme>genero', formatter: '.formatarGenero'}" /> -->

						</template>
					</Column>

					<Column width="6rem" hAlign="Center">
						<m:Label text="Nota"/>
						<template>
							<u:Currency value="{filme>nota}"/>
						</template>
					</Column>

					<Column width="7rem" hAlign="Center">
						<m:Label text="Classificação" />
						<template>
							<m:ObjectStatus text="{filme>classificacao}"/> 
						</template>
					</Column>

					<Column width="9rem" hAlign="Center">
						<m:Label text="Disponivel no plano" />
						<template>
							<m:CheckBox selected="{filme>disponivelNoPlano}"/>
						</template>
					</Column>

					<Column width="8rem" hAlign="Center">
						<m:Label text="Duracao" />
						<template>
							<u:Currency value="{filme>duracao}"/>
						</template>
					</Column>
	
					<Column width="16rem" hAlign="Center">
						<m:Label text="Data de Lancamento" />
						<template>
							<m:DatePicker value="{
								path: '{filme>dataDeLancamento}',
								type: 'sap.ui.model.type.Date',
								formatOptions: {source: {pattern: 'timestamp'}}
							}"/>
						</template>
					</Column>
				</columns>
			</Table>
		</m:content>
	</m:Page>
</mvc:View>