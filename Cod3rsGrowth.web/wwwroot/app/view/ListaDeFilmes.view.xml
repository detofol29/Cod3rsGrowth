<mvc:View
	controllerName="cod3rsgrowth.app.controller.ListaDeFilmes"
	xmlns="sap.ui.table"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:u="sap.ui.unified"
	xmlns:c="sap.ui.core"
	xmlns:m="sap.m"
    height="100%"
	xmlns:core="sap.ui.core">
	<m:Page
		id="ListaDeFilmes"
		showHeader="false"
		enableScrolling="false"
		class="sapUiContentPadding">
		<m:content>
			<Table
				id = "tabelaFilmes"
				rows="{filme>/}"
				selectionMode="MultiToggle"
				paste="app"
				ariaLabelledBy="title">
				<extension>
					<m:HBox>
						<m:items>
							<c:Icon src="sap-icon://video" alt="Cart" size="1.5rem"/>
							<m:Title text="Lista de Filmes" titleStyle="H3" class="sapUiTinyMarginBeginEnd"/>
						</m:items>
					</m:HBox>
					<m:OverflowToolbar style="Clear">
						<m:Title id="title" text="Filmes"/>
						<m:ToolbarSpacer/>
						<m:SearchField
							placeholder="Pesquisar"
							value="{ui>/filterValue}"
							search="handleTxtFilter"
							width="15rem"/>
						<!-- <ComboBox
							items="{
								path: 'generos>/',
								sorter: { path: 'text' }
							}">
							<core:Item key="{key}" text="{text}" />
						</ComboBox> -->
						<m:ComboBox
							id="comboBoxStatusConta"
							placeholder="Status da conta"
							width="auto"
							items="{
								path: 'genero>/',
								sorter: { path: 'genero>descricao' }
							}">
							<c:Item key="{genero>id}" text="{genero>descricao}" />
						</m:ComboBox>
						<m:ToggleButton
							id="toggleFiltros"
							text="filtrar"
							icon="sap-icon://filter"
							tooltip="filtrar"
							visible="true" press=".aoPressionarBotaoFiltros"/>
						<m:ToolbarSeparator />
					</m:OverflowToolbar>
				</extension>
				<columns>
					<Column width="18rem" hAlign="Center">
						<m:Label text="Titulo" />
						<template>
							<m:Text text="{filme>titulo}" wrapping="false" />
						</template>
					</Column>
					<Column width="9rem" hAlign="Center">
						<m:Label text="Gênero" />
						<template>
							<m:ObjectStatus text="{path: 'filme>genero', formatter: '.obterGenero'}"/>
						</template>
					</Column>

					<Column width="6rem" hAlign="Center">
						<m:Label text="Nota"/>
						<template>
							<u:Currency value="{filme>nota}"/>
						</template>
					</Column>

					<Column width="7rem" hAlign="Center">
						<m:Label text="Classificação" />
						<template>
							<m:ObjectStatus text="{path: 'filme>classificacao', formatter: '.obterClassificacao'}"/> 
						</template>
					</Column>

					<Column width="9rem" hAlign="Center">
						<m:Label text="Disponivel no plano" />
						<template>
							<m:ObjectStatus text="{path: 'filme>disponivelNoPlano', formatter: '.formatarDisponivel'}"/>
						</template>
					</Column>

					<Column width="8rem" hAlign="Center">
						<m:Label text="Duracao" />
						<template>
							<u:Currency value="{filme>duracao}"/>
						</template>
					</Column>

					<Column width="12rem" hAlign="Center">
						<m:Label text="Diretor(es)" />
						<template>
							<m:Text text="{filme>diretor}" wrapping="false" />
						</template>
					</Column>
	
					<Column width="10rem" hAlign="Center">
						<m:Label text="Data de Lançamento" />
						<template>
							<m:DatePicker value="{path: 'filme>dataDeLancamento', formatter: '.formatarData'}" displayFormat="dd/MM/yyyy" editable="false"/>
						</template>
					</Column>
				</columns>
				<footer>
					<m:OverflowToolbar id="infobar"></m:OverflowToolbar>
				</footer>
			</Table>
		</m:content>
	</m:Page>
</mvc:View>