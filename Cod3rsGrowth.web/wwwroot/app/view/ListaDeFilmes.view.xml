<mvc:View
	controllerName="cod3rsgrowth.app.controller.ListaDeFilmes"
	xmlns="sap.ui.table"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:u="sap.ui.unified"
	xmlns:c="sap.ui.core"
	xmlns:m="sap.m"
    height="100%"
	xmlns:core="sap.ui.core">
	<m:Page
		id="ListaDeFilmes"
		showHeader="false"
		enableScrolling="false"
		class="sapUiContentPadding">
		<m:content>
			<Table
				id = "tabelaFilmes"
				rows="{filme>/}"
				selectionMode="MultiToggle"
				ariaLabelledBy="title">
				<extension>
					<m:HBox>
						<m:items>
							<c:Icon src="sap-icon://video" alt="Cart" size="1.5rem"/>
							<m:Title text="Lista de Filmes" titleStyle="H3" class="sapUiTinyMarginBeginEnd"/>
						</m:items>
					</m:HBox>
					<m:OverflowToolbar style="Clear">
						<m:Title id="title" text="Filmes"/>
						<m:ToolbarSpacer/>
						<m:SearchField
							id="filtroTitulo"
							change= "aoPerderFocoBarraDePesquisa"
							placeholder="Pesquisar"
							value="{ui>/filterValue}"
							search="aoFiltrarFilmes"
							width="15rem"/>
						<m:ComboBox
							id="filtroGenero"
							placeholder="Genero"
							width="7rem"
							items="{ path: 'Generos>/' }"
							change= "aoSelecionarItem">
							<c:Item key="{Generos>id}" text="{Generos>descricao}" />
						</m:ComboBox>
						<m:ToggleButton
							id="toggleFiltros"
							text="filtrar"
							icon="sap-icon://filter"
							tooltip="filtrar"
							visible="true" press="aoAClicarEmFiltrar"/>
						<m:ToolbarSeparator />
					</m:OverflowToolbar>
				</extension>
				<columns>
					<Column width="18rem" hAlign="Center">
						<m:Label text="Título" />
						<template>
							<m:Text text="{filme>titulo}" wrapping="false" />
						</template>
					</Column>
					<Column width="9rem" hAlign="Center">
						<m:Label text="Gênero" />
						<template>
							<m:ObjectStatus text="{path: 'filme>genero', formatter: '.obterGenero'}"/>
						</template>
					</Column>

					<Column width="6rem" hAlign="Center">
						<m:Label text="Nota"/>
						<template>
							<u:Currency value="{filme>nota}"/>
						</template>
					</Column>

					<Column width="7rem" hAlign="Center">
						<m:Label text="Classificação" />
						<template>
							<m:ObjectStatus text="{path: 'filme>classificacao', formatter: '.formatarClassificacao'}"/> 
						</template>
					</Column>

					<Column width="9rem" hAlign="Center">
						<m:Label text="Disponível no plano" />
						<template>
							<m:ObjectStatus text="{path: 'filme>disponivelNoPlano', formatter: '.formatarDisponivel'}"/>
						</template>
					</Column>

					<Column width="8rem" hAlign="Center">
						<m:Label text="Duração" />
						<template>
							<u:Currency value="{filme>duracao}"/>
						</template>
					</Column>

					<Column width="12rem" hAlign="Center">
						<m:Label text="Diretor(es)" />
						<template>
							<m:Text text="{filme>diretor}" wrapping="false" />
						</template>
					</Column>
	
					<Column width="10rem" hAlign="Center">
						<m:Label text="Data de Lançamento" />
						<template>
							<m:DatePicker value="{path: 'dataDeLancamento', formatter: '.formatarData'}" displayFormat="dd/MM/yyyy" editable="false"/>
						</template>
					</Column>
				</columns>
				<footer>
					<m:OverflowToolbar id="infobar"></m:OverflowToolbar>
				</footer>
			</Table>
		</m:content>
	</m:Page>
</mvc:View>